{
    "name": "number-cruncher",
    "author": "Noran Diaconu",
    "version": "1.6.5",
    "license": "MIT",
    "bin": {
        "number-cruncher": "index.js"
    },
    "scripts": {
        "start": "start http://localhost:8080 && http-server ./docs -a localhost -p 8080",
        "build": "ng build",
        "test": "jest",
        "lint": "eslint .",
        "//electron": "echo 'electron scripts require global installation of electron-builder'",
        "electron": "electron-builder --win=dir",
        "electron-installer": "electron-builder --win=nsis-web",
        "electron-portable": "electron-builder --win=portable",
        "full": "npm run lint && npm run test && npm run build && npm run start"
    },
    "dependencies": {
        "@angular/animations": "^18.2.13",
        "@angular/common": "^18.2.13",
        "@angular/compiler": "^18.2.13",
        "@angular/core": "^18.2.13",
        "@angular/platform-browser": "^18.2.13",
        "@angular/platform-browser-dynamic": "^18.2.13",
        "http-server": "^14.1.1",
        "mathjs": "~13.2.0",
        "rxjs": "~6.6.0",
        "tslib": "^2.3.0",
        "zone.js": "~0.14.10"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^18.2.18",
        "@angular-eslint/builder": "18.4.3",
        "@angular-eslint/eslint-plugin": "18.4.3",
        "@angular-eslint/eslint-plugin-template": "18.4.3",
        "@angular-eslint/schematics": "18.4.3",
        "@angular-eslint/template-parser": "18.4.3",
        "@angular/cli": "^18.2.18",
        "@angular/compiler-cli": "^18.2.13",
        "@types/jest": "~29.5.4",
        "@types/node": "^18.11.9",
        "@typescript-eslint/eslint-plugin": "7.11.0",
        "@typescript-eslint/eslint-plugin-tslint": "~7.0.2",
        "@typescript-eslint/parser": "7.11.0",
        "eslint": "^8.57.0",
        "eslint-plugin-import": "~2.29.1",
        "jest": "29.6.1",
        "jest-preset-angular": "~14.5.5",
        "typescript": "~5.4.5"
    },
    "main": "main.ts",
    "keywords": [
        "number",
        "cruncher"
    ],
    "homepage": "https://github.com/norandiaconu/number-cruncher#readme",
    "repository": {
        "type": "git",
        "url": "https://github.com/norandiaconu/number-cruncher.git"
    },
    "build": {
        "artifactName": "number-cruncher.exe",
        "electronVersion": "25.3.0",
        "nsis": {
            "differentialPackage": false
        },
        "win": {
            "asar": false
        }
    }
}
